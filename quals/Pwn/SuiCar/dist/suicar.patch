+BUILTIN(SuiArrayPack) {
+  HandleScope scope(isolate);
+
+  Handle<Object> input = args.atOrUndefined(isolate, 1);
+  if (!IsJSArray(*input)) return ReadOnlyRoots(isolate).undefined_value();
+
+  Handle<JSArray> source = Handle<JSArray>::cast(input);
+  uint32_t length = 0;
+  CHECK(Object::ToArrayLength(source->length(), &length));
+  if (length > static_cast<uint32_t>(FixedDoubleArray::kMaxLength)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  if (length == 0) {
+    return *isolate->factory()->NewJSArray(PACKED_DOUBLE_ELEMENTS, 0, 0);
+  }
+
+  Handle<FixedArrayBase> storage =
+      isolate->factory()->NewFixedDoubleArray(static_cast<int>(length));
+  Handle<JSArray> result = isolate->factory()->NewJSArrayWithElements(
+      storage, PACKED_DOUBLE_ELEMENTS, static_cast<int>(length));
+  Handle<FixedDoubleArray> doubles = Handle<FixedDoubleArray>::cast(storage);
+
+  for (uint32_t i = 0; i < length; ++i) {
+    Handle<Object> value;
+    ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+        isolate, value, Object::GetElement(isolate, source, i));
+    if (!IsNumber(*value)) return ReadOnlyRoots(isolate).undefined_value();
+    doubles->set(static_cast<int>(i), Object::Number(*value));
+  }
+
+  return *result;
+}
+
+BUILTIN(SuiArrayKind) {
+  HandleScope scope(isolate);
+
+  Handle<Object> obj = args.atOrUndefined(isolate, 1);
+  if (!IsJSArray(*obj)) return *SuiString(isolate, "not-array");
+
+  Handle<JSArray> array = Handle<JSArray>::cast(obj);
+  ElementsKind kind = array->GetElementsKind();
+  if (kind == PACKED_DOUBLE_ELEMENTS || kind == HOLEY_DOUBLE_ELEMENTS) {
+    return *SuiString(isolate, "telemetry-double");
+  }
+  if (kind == PACKED_ELEMENTS || kind == HOLEY_ELEMENTS) {
+    return *SuiString(isolate, "telemetry-object");
+  }
+  if (kind == PACKED_SMI_ELEMENTS || kind == HOLEY_SMI_ELEMENTS) {
+    return *SuiString(isolate, "telemetry-smi");
+  }
+  return *SuiString(isolate, "telemetry-other");
+}
+
+BUILTIN(SuiArrayFastMap) {
+  HandleScope scope(isolate);
+
+  Handle<Object> samples_obj = args.atOrUndefined(isolate, 1);
+  Handle<Object> callback_obj = args.atOrUndefined(isolate, 2);
+  Handle<Object> index_obj = args.atOrUndefined(isolate, 3);
+  Handle<Object> value_obj = args.atOrUndefined(isolate, 4);
+
+  if (!IsJSArray(*samples_obj) || !IsCallable(*callback_obj)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  Handle<JSArray> samples = Handle<JSArray>::cast(samples_obj);
+  if (!IsSuiDoubleArray(*samples)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  Handle<Object> converted_index;
+  ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+      isolate, converted_index, Object::ToInt32(isolate, index_obj));
+  int32_t index = 0;
+  CHECK(Object::ToInt32(*converted_index, &index));
+
+  Handle<Object> receiver = isolate->factory()->undefined_value();
+  MaybeHandle<Object> maybe_result =
+      Execution::Call(isolate, callback_obj, receiver, 0, nullptr);
+  if (maybe_result.is_null()) return ReadOnlyRoots(isolate).exception();
+
+  Tagged<FixedDoubleArray> elements =
+      FixedDoubleArray::cast(samples->elements());
+  double previous = elements->get_scalar(index);
+
+  if (!IsUndefined(*value_obj, isolate)) {
+    if (!IsNumber(*value_obj)) return ReadOnlyRoots(isolate).undefined_value();
+    elements->set(index, Object::Number(*value_obj));
+    // Returning the original number avoids an allocation after the raw write.
+    return *value_obj;
+  }
+
+  return *isolate->factory()->NewNumber(previous);
+}
+
+BUILTIN(SuiTeleMakeFrame) {
+  HandleScope scope(isolate);
+
+  Handle<Object> samples = args.atOrUndefined(isolate, 1);
+  Handle<JSObject> frame = isolate->factory()->NewJSObject(
+      isolate->object_function(), AllocationType::kYoung);
+
+  JSObject::AddProperty(isolate, frame, SuiString(isolate, "samples"),
+                        samples, NONE);
+  JSObject::AddProperty(isolate, frame, SuiString(isolate, "model"),
+                        SuiString(isolate, "SuiCar-Stellar"), NONE);
+  JSObject::AddProperty(isolate, frame, SuiString(isolate, "mode"),
+                        SuiString(isolate, "star-drive"), NONE);
+  return *frame;
+}
+
+BUILTIN(SuiTeleCalibrate) {
+  HandleScope scope(isolate);
+
+  Handle<Object> frame_obj = args.atOrUndefined(isolate, 1);
+  Handle<Object> callback_obj = args.atOrUndefined(isolate, 2);
+  if (!IsJSReceiver(*frame_obj) || !IsCallable(*callback_obj)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  Handle<JSReceiver> frame = Handle<JSReceiver>::cast(frame_obj);
+  Handle<Object> samples_obj;
+  ASSIGN_RETURN_FAILURE_ON_EXCEPTION(
+      isolate, samples_obj,
+      JSReceiver::GetProperty(isolate, frame, SuiString(isolate, "samples")));
+  if (!IsJSArray(*samples_obj)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  Handle<JSArray> samples = Handle<JSArray>::cast(samples_obj);
+  if (!IsSuiDoubleArray(*samples)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  uint32_t old_len = 0;
+  CHECK(Object::ToArrayLength(samples->length(), &old_len));
+  if (old_len == 0) return *frame_obj;
+
+  Handle<Object> receiver = isolate->factory()->undefined_value();
+  MaybeHandle<Object> maybe_result =
+      Execution::Call(isolate, callback_obj, receiver, 0, nullptr);
+  if (maybe_result.is_null()) return ReadOnlyRoots(isolate).exception();
+
+
+  Tagged<FixedDoubleArray> elements =
+      FixedDoubleArray::cast(samples->elements());
+  elements->set(0, 13.37);
+
+  return *frame_obj;
+}
+
+BUILTIN(SuiTeleRenderFrame) {
+  HandleScope scope(isolate);
+  Handle<Object> frame = args.atOrUndefined(isolate, 1);
+  if (!IsJSReceiver(*frame)) return ReadOnlyRoots(isolate).undefined_value();
+  return *SuiString(isolate, "[SuiTele frame rendered]");
+}
+
+BUILTIN(SuiTeleExportFrame) {
+  HandleScope scope(isolate);
+  return *SuiString(isolate, "[SuiTele frame exported]");
+}
+
+BUILTIN(SuiDashRender) {
+  HandleScope scope(isolate);
+
+  Handle<Object> callback_obj = args.atOrUndefined(isolate, 1);
+  if (!IsCallable(*callback_obj)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  Handle<Object> receiver = isolate->factory()->undefined_value();
+  MaybeHandle<Object> maybe_result =
+      Execution::Call(isolate, callback_obj, receiver, 0, nullptr);
+  if (maybe_result.is_null()) return ReadOnlyRoots(isolate).exception();
+
+  return *SuiString(isolate, "dashboard-ok");
+}
