From 5354454c4c415221 Mon Sep 17 00:00:00 2001
From: STELLAR Archive Maintainer <stellar@localhost>
Date: Thu, 3 Sep 2026 22:00:00 -0400
Subject: [PATCH] tauri: add encrypted STELLAR Native GIF asset pipeline

Base: crates.io tauri 2.8.5

This is the sole framework feature added by the challenge fork. GIF sources are
sealed into generated STLRGIF records at build time. The resolver decrypts the
selected record, validates CRC32, decodes it with stellar-gif, and returns SGIF
frames to the webview.
---
 crates/tauri/Cargo.toml     |  2 ++
 crates/tauri/src/lib.rs     |  3 +++
 crates/tauri/src/stellar.rs | 91 +++++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 96 insertions(+)
 create mode 100644 crates/tauri/src/stellar.rs

diff --git a/crates/tauri/Cargo.toml b/crates/tauri/Cargo.toml
--- a/crates/tauri/Cargo.toml
+++ b/crates/tauri/Cargo.toml
@@
+stellar-gif = { path = "../stellar-gif" }
+crc32fast = "1.5"
diff --git a/crates/tauri/src/lib.rs b/crates/tauri/src/lib.rs
--- a/crates/tauri/src/lib.rs
+++ b/crates/tauri/src/lib.rs
@@
+/// Encrypted native GIF assets and SGIF playback for the STELLAR archive.
+#[cfg(desktop)]
+pub mod stellar;
diff --git a/crates/tauri/src/stellar.rs b/crates/tauri/src/stellar.rs
new file mode 100644
--- /dev/null
+++ b/crates/tauri/src/stellar.rs
@@
+use crate::{
+    http::{header, Request, Response, StatusCode},
+    Builder, Runtime, Wry,
+};
+
+#[path = "generated_assets.rs"]
+mod generated_assets;
+use generated_assets::{EncryptedAsset, ENCRYPTED_ASSETS};
+
+const VAULT_MAGIC: &[u8; 8] = b"STLRGIF\0";
+const VAULT_KEY: u64 = 0x7a31_d6e9_4c52_b80f;
+
+fn asset(name: &str) -> Option<&'static EncryptedAsset> {
+    let name = name.rsplit('/').next().unwrap_or(name);
+    ENCRYPTED_ASSETS.iter().find(|asset| asset.name == name)
+}
+
+#[inline(never)]
+fn crypt_asset(data: &[u8], id: u64, nonce: u64) -> Vec<u8> {
+    let mut state = VAULT_KEY ^ id.rotate_left(17) ^ nonce.rotate_right(9);
+    data.iter().enumerate().map(|(index, byte)| {
+        state ^= state << 13;
+        state ^= state >> 7;
+        state ^= state << 17;
+        state = state.wrapping_add(
+            0x9e37_79b1_85eb_ca87u64
+                ^ (index as u64).wrapping_mul(0x100_0000_01b3),
+        );
+        byte ^ state.rotate_right(((index & 7) * 8) as u32) as u8
+    }).collect()
+}
+
+#[inline(never)]
+fn open_asset(asset: &EncryptedAsset) -> Result<Vec<u8>, &'static str> {
+    let record = asset.bytes;
+    if record.len() < 36 || &record[..8] != VAULT_MAGIC || record[8] != 1 {
+        return Err("invalid stellar gif vault header");
+    }
+    let id = u64::from_le_bytes(record[12..20].try_into().unwrap());
+    let nonce = u64::from_le_bytes(record[20..28].try_into().unwrap());
+    let length = u32::from_le_bytes(record[28..32].try_into().unwrap()) as usize;
+    let checksum = u32::from_le_bytes(record[32..36].try_into().unwrap());
+    if id != asset.id || record.len() != 36 + length {
+        return Err("invalid stellar gif vault length");
+    }
+    let plain = crypt_asset(&record[36..], id, nonce);
+    if crc32fast::hash(&plain) != checksum {
+        return Err("stellar gif vault checksum rejected");
+    }
+    Ok(plain)
+}
+
+#[inline(never)]
+fn resolve_asset<R: Runtime>(
+    _ctx: crate::UriSchemeContext<'_, R>,
+    request: Request<Vec<u8>>,
+) -> Response<Vec<u8>> {
+    let result = asset(request.uri().path())
+        .ok_or_else(|| "asset not found".to_string())
+        .and_then(|asset| open_asset(asset).map_err(str::to_string))
+        .and_then(|gif| stellar_gif::decode(&gif)
+            .map_err(|error| format!("stellar animation decode failed: {error}")))
+        .map(|animation| stellar_gif::encode_sgif(&animation));
+    match result {
+        Ok(body) => Response::builder()
+            .status(StatusCode::OK)
+            .header(header::CONTENT_TYPE, "application/x-stellar-gif")
+            .header(header::CACHE_CONTROL, "no-store")
+            .header(header::ACCESS_CONTROL_ALLOW_ORIGIN, "*")
+            .body(body).unwrap(),
+        Err(message) => Response::builder()
+            .status(StatusCode::NOT_FOUND)
+            .header(header::CONTENT_TYPE, "text/plain")
+            .header(header::ACCESS_CONTROL_ALLOW_ORIGIN, "*")
+            .body(message.into_bytes()).unwrap(),
+    }
+}
+
+pub fn builder() -> Builder<Wry> {
+    Builder::default().register_uri_scheme_protocol("stellar", resolve_asset::<Wry>)
+}
